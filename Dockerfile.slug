FROM python@sha256:392307d22300de8b5986851a12d9176dfc0fc073e65bf6523ebd7dcbeb23564e
ARG SOURCE_SHA
ENV SOURCE_SHA=${SOURCE_SHA} PYTHONDONTWRITEBYTECODE=1
LABEL delivery-kit.source-sha="${SOURCE_SHA}"
WORKDIR /app
COPY slugapp.py serve_slug.py ./
USER 10000:10000
EXPOSE 8080
CMD ["python", "serve_slug.py"]
